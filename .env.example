# ---- Sista settings ----
# Run "npm run setup" to fill the secret keys automatically.
SISTA_DATA_KEY=
SISTA_SECRET=
SISTA_DB_PATH=./data/sista.db
SISTA_RETENTION_DAYS=30
SISTA_PUBLIC_URL=http://localhost:3000
PORT=3000

# ---- WhatsApp Cloud API (Meta) ----
WA_TOKEN=
WA_PHONE_ID=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
WA_DISPLAY_NUMBER=
WA_REENGAGE_TEMPLATE=
WA_ALERT_TEMPLATE=

# ---- AI listening mode (optional) ----
ANTHROPIC_API_KEY=
SISTA_AI_MODEL=claude-haiku-5-5

# ---- On-call alerts ----
SISTA_ONCALL_NUMBERS=
ALERT_WEBHOOK_URL=

NODE_ENV=development
